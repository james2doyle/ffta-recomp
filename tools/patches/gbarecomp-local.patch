+// Wrap-aware 9-bit scroll delta, folded to [-256, 256].
+inline int32_t fold_scroll_delta(int32_t d) {
+    d %= 512;
+    if (d > 256)
+        d -= 512;
+    else if (d < -256)
+        d += 512;
+    return d;
