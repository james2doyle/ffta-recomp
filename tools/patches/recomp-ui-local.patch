+// A list taller than its panel has to scroll both ways: the host drives the
+// selection from a d-pad or the arrow keys, and on touch a finger drags the
+// list instead. Before the presentation followed the selection, the highlight
+// walked off the bottom of the panel and d-pad navigation looked dead; before
+// it took drags, a swipe did nothing at all (an ImGui child scrolls only from
+// the wheel or by dragging its scrollbar).
+void list_scroll_case() {
+    static const char *const kLabels[] = { "Assist Tools", "Rewind 1 second",
+                                           "Fast-forward", "Fast-forward speed",
+                                           "State slot", "Load state",
+                                           "Save state" };
+    RecompRuntimeUiItem items[7];
+    for (int i = 0; i < 7; ++i) {
+        items[i].key = "scroll";
+        items[i].section = "Assist Tools";
+        items[i].label = kLabels[i];
+        // A description makes each row taller than the bare label, the shape
+        // a real settings page has.
+        items[i].description = "A description makes this row taller.";
+        items[i].type = i >= 5 ? RECOMP_RUNTIME_UI_ACTION : RECOMP_RUNTIME_UI_BOOL;
+        items[i].minimum = 0;
+        items[i].maximum = 1;
+        items[i].step = 1;
+    }
+    int value = 0;
+    RecompRuntimeUiConfig config{};
+    config.title = "Runtime UI";
+    config.subtitle = "GAME BOY ADVANCE";
+    config.items = items;
+    config.item_count = 7;
+    config.theme = "gba";
+    config.callbacks.context = &value;
+    config.callbacks.get_value = get_value;
+    config.callbacks.set_value = set_value;
+    config.presentation_flags = RECOMP_RUNTIME_UI_PRESENTATION_TOUCH_FRIENDLY;
+    RecompRuntimeUi *ui = recomp_runtime_ui_create(&config);
+    assert(ui != nullptr);
+    recomp_runtime_ui_open(ui);
+    // Into the first section, the way a player does it.
+    recomp_runtime_ui_handle_input(ui, RECOMP_RUNTIME_UI_INPUT_ACCEPT, 1, 0);
+
+    IMGUI_CHECKVERSION();
+    ImGui::CreateContext();
+    ImGuiIO &io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    io.DisplaySize = ImVec2(2400.0f, 1080.0f);   // phone, landscape
+    io.DeltaTime = 1.0f / 60.0f;
+    unsigned char *font_pixels = nullptr;
+    int font_w = 0, font_h = 0;
+    io.Fonts->GetTexDataAsRGBA32(&font_pixels, &font_w, &font_h);
+
+    auto frame = [&]() {
+        ImGui::NewFrame();
+        recomp_runtime_ui_render_imgui(ui);
+        ImGui::Render();
+    };
+    // The rows live in a child of the menu window, whose name carries a
+    // per-parent suffix, so match on the stable part.
+    auto rows = [&]() -> ImGuiWindow * {
+        for (int i = 0; i < ImGui::GetCurrentContext()->Windows.Size; ++i) {
+            ImGuiWindow *window = ImGui::GetCurrentContext()->Windows[i];
+            if (std::strstr(window->Name, "##items")) return window;
+        }
+        return nullptr;
+    };
+    for (int i = 0; i < 4; ++i) frame();
+    ImGuiWindow *list = rows();
+    assert(list != nullptr);
+    assert(list->ScrollMax.y > 0.0f);   // the page really does overflow
+
+    // Host-driven navigation: one press per frame, the way a d-pad reports.
+    // A scroll set during a frame lands in the child's next one, so a press is
+    // followed by a second frame before the list is read.
+    auto press = [&](RecompRuntimeUiInput input) {
+        recomp_runtime_ui_handle_input(ui, input, 1, 0);
