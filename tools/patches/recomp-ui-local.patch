+// ── List scrolling ──────────────────────────────────────────────────────────
+//
+// The host owns the selection: recomp_runtime_ui_handle_input() moves
+// section_index / row_index from a d-pad, an arrow key or a tap, and the menu
+// runs with ImGuiWindowFlags_NoNavInputs so ImGui never drives a second cursor
+// over the same rows. That leaves the list window to do the scrolling itself,
+// or a selected row below the fold simply stays below the fold: the highlight
+// walks off the bottom of the panel and d-pad navigation looks dead.
+
+// A press has to travel this far before it stops being a tap on the row under
+// the finger and becomes a scroll.
+constexpr float kDragThreshold = 10.0f;
+// The fling coasts above this speed (ImGui pixels/second) and bleeds off at
+// this many e-folds per second.
+constexpr float kFlingCutoff = 80.0f;
+constexpr float kFlingDecay = 5.0f;
+
+// The wide layout draws two lists (the section sidebar and the rows), the
+// narrow one a single list. Which one owns a gesture is decided by the caller,
+// so no private ImGui window handle is needed to tell them apart.
+enum ListId { kListSidebar = 0, kListRows = 1 };
+
+void end_list_gesture(RecompRuntimeUi *ui) {
+    ui->list.owner = -1;
+    ui->list.armed = 0;
+    ui->list.velocity = 0.0f;
+}
+
+// True while a drag owns the pointer in the list being drawn.
+bool list_dragging(const RecompRuntimeUi *ui, int list) {
+    return ui->list.armed != 0 && ui->list.owner == list;
+}
+
+// Scrolls the list by the least amount that brings the item just drawn -- the
+// selected row -- into view. Only called when the selection actually moved: a
+// player who scrolled away from the highlight keeps their position until they
+// press a direction again.
+void follow_selection(RecompRuntimeUi *ui, int list, size_t index) {
+    if (ui->list.follow_list == list &&
+        ui->list.follow_index == static_cast<long long>(index))
+        return;
+    ui->list.follow_list = list;
+    ui->list.follow_index = static_cast<long long>(index);
+    const ImVec2 item_min = ImGui::GetItemRectMin();
+    const ImVec2 item_max = ImGui::GetItemRectMax();
+    const float scroll = ImGui::GetScrollY();
+    if (item_min.y < ui->list.inner_top)
+        ImGui::SetScrollY(scroll + (item_min.y - ui->list.inner_top));
+    else if (item_max.y > ui->list.inner_bottom)
+        ImGui::SetScrollY(scroll + (item_max.y - ui->list.inner_bottom));
+}
+
+// Touch drags. The SDL backends hand fingers to the UI as a mouse, and an
+// ImGui child scrolls only from the wheel or by dragging its scrollbar, so a
+// swipe over the list did nothing at all. `enabled` is the touch-friendly
+// presentation: on a desktop a drag over a row is a player's click and the
+// wheel is right there.
+//
+// The gesture runs in two halves because the rows decide for themselves
+// whether they are a control: `begin_list_drag` runs the drag in flight at the
+// top of the child (where the list's scrollable band can still be measured
+// before any row moves the cursor), and `end_list_drag` claims a press the
+// list has just seen, at the bottom, now that over_control is known.
+void begin_list_drag(RecompRuntimeUi *ui, bool enabled, int list) {
+    ImGuiIO &io = ImGui::GetIO();
+    // The list's scrollable band, measured before any row moves the cursor.
+    // GetWindowPos/Size rather than GetCursorScreenPos/GetContentRegion*:
+    // inside a scrolled child those mix scroll and screen space, and only the
+    // window's own rect is in one piece.
+    const ImVec2 corner = ImGui::GetWindowPos();
+    ui->list.inner_top = corner.y;
+    ui->list.inner_bottom = corner.y + ImGui::GetWindowHeight();
+
+    if (!enabled || ui->list.owner != list) return;
+    if (io.MouseWheel != 0.0f) {   // the player took the wheel back
+        end_list_gesture(ui);
+        return;
+    }
+    const float dt = io.DeltaTime > 0.0f ? io.DeltaTime : 1.0f / 60.0f;
+    if (ImGui::IsMouseDown(ImGuiMouseButton_Left)) {
+        const float dy = ui->list.last_y - io.MousePos.y;  // finger up scrolls down
+        ui->list.last_y = io.MousePos.y;
+        if (!ui->list.armed &&
+            std::fabs(io.MousePos.y - ui->list.press_y) > kDragThreshold) {
+            ui->list.armed = 1;
+            ui->list.velocity = 0.0f;
+        }
+        if (ui->list.armed) {
+            ImGui::SetScrollY(ImGui::GetScrollY() + dy);
+            ui->list.velocity = ui->list.velocity * 0.6f + (dy / dt) * 0.4f;
+        }
+        return;
+    }
+    // Released: coast to a stop at the speed the finger left behind. Rows stay
+    // muted while the fling runs, so it cannot hand the selection to whatever
+    // row happens to pass under a resting finger.
+    if (ui->list.armed && std::fabs(ui->list.velocity) > kFlingCutoff) {
+        ImGui::SetScrollY(ImGui::GetScrollY() + ui->list.velocity * dt);
+        ui->list.velocity *= std::exp(-kFlingDecay * dt);
+    } else {
+        end_list_gesture(ui);
+    }
+}
+
+// Claims a press for the list, so the frames that follow can tell a swipe from
+// a tap. A press on a -/+ button, an edit field or the back button is left
+// alone (over_control), and so is the scrollbar's own strip along the right
+// edge: both belong to something else.
+void end_list_drag(RecompRuntimeUi *ui, bool enabled, int list) {
+    if (!enabled || (ui->list.owner >= 0 && ui->list.owner != list)) return;
+    if (!ImGui::IsMouseClicked(ImGuiMouseButton_Left)) return;
+    // Any new press takes the pointer back from a coasting list, wherever it
+    // landed: the finger is on the screen again, and a list that keeps moving
+    // under it is the one thing that reads as out of control.
+    end_list_gesture(ui);
+    ImGuiIO &io = ImGui::GetIO();
+    const float scrollbar_x = ImGui::GetWindowPos().x + ImGui::GetWindowWidth() -
+                              ImGui::GetStyle().ScrollbarSize;
+    // AllowWhenBlockedByActiveItem: by now the rows have run, so the press has
+    // already made the row under the finger the active item, and a plain
+    // IsWindowHovered() would call the list unhovered because of it.
+    if (ImGui::GetScrollMaxY() <= 0.0f || io.MousePos.x > scrollbar_x ||
+        ui->list.over_control || ui->editing_text ||
+        !ImGui::IsWindowHovered(ImGuiHoveredFlags_AllowWhenBlockedByActiveItem))
+        return;
+    ui->list.owner = list;
+    ui->list.armed = 0;
+    ui->list.press_y = io.MousePos.y;
+    ui->list.last_y = io.MousePos.y;
+}
