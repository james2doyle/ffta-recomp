+    const float coasted = list->Scroll.y;
+    assert(coasted > dragged);
+    for (int i = 0; i < 240; ++i) frame();
+    assert(list->Scroll.y <= list->ScrollMax.y + 1.0f);
+
+    // A plain tap still belongs to the row under the finger.
+    frame();
+    const ImVec2 row = list->InnerRect.GetCenter();
+    io.AddMousePosEvent(row.x, row.y);
+    io.AddMouseButtonEvent(0, true);
+    frame();
+    io.AddMouseButtonEvent(0, false);
+    frame();
+    assert(value == 1);   // the BOOL row under the tap toggled
+
+    ImGui::DestroyContext();
+    recomp_runtime_ui_destroy(ui);
+}
+
+// The same follow on the desktop presentation, which has no drag-scroll: a
+// long page of plain rows in a short window, walked with the d-pad.
+void desktop_nav_scroll_case() {
+    static const RecompRuntimeUiItem kMany[] = {
+        { "d", "System", "Row 01", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 02", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 03", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 04", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 05", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 06", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 07", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 08", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 09", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 10", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 11", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 12", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 13", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 14", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 15", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "d", "System", "Row 16", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+    };
+    int value = 0;
+    RecompRuntimeUiConfig config{};
+    config.title = "Runtime UI";
+    config.items = kMany;
+    config.item_count = sizeof(kMany) / sizeof(kMany[0]);
+    config.theme = "n64";
+    config.callbacks.context = &value;
+    config.callbacks.get_value = get_value;
+    config.callbacks.set_value = set_value;
+    RecompRuntimeUi *ui = recomp_runtime_ui_create(&config);
+    assert(ui != nullptr);
+    recomp_runtime_ui_open(ui);
+    recomp_runtime_ui_handle_input(ui, RECOMP_RUNTIME_UI_INPUT_ACCEPT, 1, 0);
+
+    IMGUI_CHECKVERSION();
+    ImGui::CreateContext();
+    ImGuiIO &io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    io.DisplaySize = ImVec2(1280.0f, 720.0f);
+    io.DeltaTime = 1.0f / 60.0f;
+    unsigned char *font_pixels = nullptr;
+    int font_w = 0, font_h = 0;
+    io.Fonts->GetTexDataAsRGBA32(&font_pixels, &font_w, &font_h);
+
+    auto frame = [&]() {
+        ImGui::NewFrame();
+        recomp_runtime_ui_render_imgui(ui);
+        ImGui::Render();
+    };
+    ImGuiWindow *list = nullptr;
+    for (int i = 0; i < 4; ++i) frame();
+    for (int i = 0; i < ImGui::GetCurrentContext()->Windows.Size; ++i) {
+        ImGuiWindow *window = ImGui::GetCurrentContext()->Windows[i];
+        if (std::strstr(window->Name, "##items")) list = window;
+    }
+    assert(list != nullptr);
+    assert(list->ScrollMax.y > 0.0f);
+
+    for (int i = 0; i < 15; ++i) {
+        recomp_runtime_ui_handle_input(ui, RECOMP_RUNTIME_UI_INPUT_DOWN, 1, 0);
+        frame();
+        frame();
+    }
+    assert(list->Scroll.y > 0.0f);   // the desktop list follows the d-pad too
+
+    // A desktop drag is a click, not a scroll: it must not move the list.
+    const float held = list->Scroll.y;
+    const ImVec2 start = list->InnerRect.GetCenter();
+    io.AddMousePosEvent(start.x, start.y);
+    io.AddMouseButtonEvent(0, true);
+    frame();
+    for (int i = 1; i <= 4; ++i) {
+        io.AddMousePosEvent(start.x, start.y - i * 40.0f);
+        frame();
+    }
+    io.AddMouseButtonEvent(0, false);
+    frame();
+    assert(std::fabs(list->Scroll.y - held) < 1.0f);
+
+    ImGui::DestroyContext();
+    recomp_runtime_ui_destroy(ui);
+}
