diff --git a/src/armv4t/runtime_arm.cpp b/src/armv4t/runtime_arm.cpp
index 78f06d6..c7c213c 100644
--- a/src/armv4t/runtime_arm.cpp
+++ b/src/armv4t/runtime_arm.cpp
@@ -847,10 +847,28 @@ constexpr uint32_t kBiosRegionEnd = 0x00004000u;
 
 }  // namespace
 
+// One-shot continuation for an abandoned IRQ (see runtime_irq's close): the
+// flow that kept running under the drive left its next pc in R15, but the
+// interrupted block's resumption tramples R15 before the next dispatch. The
+// first dispatch after the close is redirected there (BRINGUP § flow-continuation
+// resume). 0 = disarmed.
+static uint32_t g_abandon_resume_pc = 0;
+
 extern "C" void runtime_dispatch(uint32_t target_pc) {
     // A generated caller can fall through to another dispatch when the yielded
     // PC equals its return address. Do not enter that target or its RAM hook.
     if (gbarecomp::runtime_dispatch_suspended()) return;
+    if (g_abandon_resume_pc != 0u) {
+        const uint32_t want = g_abandon_resume_pc;
+        g_abandon_resume_pc = 0u;
+        std::fprintf(stderr,
+            "runtime_dispatch: abandon-resume intercept want=0x%08X got=0x%08X\n",
+            want, target_pc);
+        if ((target_pc & ~1u) != want) {
+            g_cpu.R[15] = want;
+            target_pc = want;
+        }
+    }
     // Strip THUMB bit; codegen handles the mode via cpsr_T already.
     uint32_t pc = target_pc & ~1u;
     if (runtime_trace_enabled())
@@ -1417,6 +1435,14 @@ extern "C" void runtime_irq(uint32_t return_address) {
     const uint32_t saved_r2  = g_cpu.R[2];
     const uint32_t saved_r3  = g_cpu.R[3];
     const uint32_t saved_r12 = g_cpu.R[12];
+    // IRQ-enable state at entry: the flow that keeps running under the drive
+    // may have disabled interrupts (the FFTA suspend save does), leaving the
+    // game's per-frame tick (set by its VBlank handler) frozen; a resumed
+    // frame-gate wait then spins forever with no dispatch for the resume
+    // interception to act on (windowed stall, 2026-10-09). An abandon close
+    // restores the entry enable state — the phantom's disable is not real.
+    const uint16_t saved_ie   = bus_read_u16(0x04000200u);
+    const uint16_t saved_ime  = bus_read_u16(0x04000208u);
     // Record the active IRQ source(s) (IE & IF) in the trace addr field and the
     // nesting depth in aux so a ring dump names which interrupt is being
     // vectored and how deep — used to pin the MC-HP-002 IRQ storm. Reading
@@ -1503,6 +1529,26 @@ extern "C" void runtime_irq(uint32_t return_address) {
     drive_irq_instruction();
     constexpr uint32_t kMaxIrqDispatches = 4'000'000u;
     uint32_t irq_guard = 0u;
+    // Abandonment detection: if the guest's IRQ-mode exception return never
+    // happens (its call frames are consumed — the return ledger is back at
+    // this IRQ's floor — while execution has clearly left the handler and
+    // keeps running outside the BIOS), or the loop simply survives several
+    // VBlank boundaries (no legal GBA IRQ handler takes multiple frames —
+    // FFTA suspend->A leaves exactly such a phantom at depth 1 while every
+    // later VBlank nests inside it), the loop must NOT adopt whatever
+    // executes next (typically mainline) and drive it forever: that leaves
+    // g_irq_nest_depth stuck and the host stack growing. Close the IRQ
+    // cleanly instead, as if the iret had fired at our depth — in every
+    // respect: 2026-10-09 proved the resumed flow IS the interrupted instant
+    // (the interrupted block re-runs), so the full interrupted snapshot
+    // (volatiles + SP/LR bank + call ledger + mode) must come back. The old
+    // skip-the-restore rule let a phantom-clobbered stack slot send the
+    // resumed helper to PC=0 (BRINGUP § true root).
+    constexpr uint32_t kAbandonAfterDispatches = 0x40000u;  // ~1 frame
+    constexpr unsigned long long kAbandonAfterVblanks = 4;
+    const unsigned long long entry_vbl = g_runtime_vblank_starts;
+    uint32_t abandoned_guard = 0u;
+    bool closed_by_abandon = false;
     while (g_irq_iret_depth != my_depth) {
         if (++irq_guard >= kMaxIrqDispatches) {
             std::fprintf(stderr,
@@ -1513,12 +1559,60 @@ extern "C" void runtime_irq(uint32_t return_address) {
             break;
         }
         drive_irq_instruction();
+        const bool handler_frames_gone =
+            g_call_return_depth <= g_call_return_floor;
+        if (g_runtime_vblank_starts - entry_vbl >= kAbandonAfterVblanks) {
+            std::fprintf(stderr,
+                "runtime_irq: handler at depth %u abandoned without an iret "
+                "(%llu vblanks, pc=0x%08X) — closing the IRQ "
+                "(flow-continuation resume pc=0x%08X)\n",
+                my_depth,
+                (unsigned long long)(g_runtime_vblank_starts - entry_vbl),
+                g_cpu.R[15], g_cpu.R[15]);
+            g_irq_iret_depth = my_depth;  // treat as completion
+            closed_by_abandon = true;
+        } else if (handler_frames_gone && g_cpu.R[15] >= 0x00004000u) {
+            if (++abandoned_guard >= kAbandonAfterDispatches) {
+                std::fprintf(stderr,
+                    "runtime_irq: handler at depth %u abandoned without an "
+                    "iret (ledger at floor, pc=0x%08X) — closing the IRQ "
+                    "(flow-continuation resume pc=0x%08X)\n",
+                    my_depth, g_cpu.R[15], g_cpu.R[15]);
+                g_irq_iret_depth = my_depth;  // treat as completion
+                closed_by_abandon = true;
+            }
+        } else {
+            abandoned_guard = 0u;
+        }
+    }
+    if (!closed_by_abandon) {
+        g_cpu.R[0]  = saved_r0;
+        g_cpu.R[1]  = saved_r1;
+        g_cpu.R[2]  = saved_r2;
+        g_cpu.R[3]  = saved_r3;
+        g_cpu.R[12] = saved_r12;
+    } else {
+        // The abandoned flow never returned to the interrupted context: the
+        // guest state (registers, stack, banks, call ledger) belongs to the
+        // flow that kept running and is already coherent — touching it would
+        // rewind to the interrupted mainline (the 2026-10-09 black-screen
+        // idle; BRINGUP § coherent close, superseded). What IS broken is the
+        // dispatch routing: the interrupted instruction's block resumes after
+        // this close and its R15 installs trample the exception-return target
+        // the guest just computed (0x814186E — the save flow's continuation).
+        // Hand that pc to the next runtime_dispatch as a one-shot resume.
+        g_abandon_resume_pc = g_cpu.R[15];
+        const uint16_t ie  = bus_read_u16(0x04000200u);
+        const uint16_t ime = bus_read_u16(0x04000208u);
+        if (ie != saved_ie || ime != saved_ime) {
+            bus_write_u16(0x04000200u, saved_ie);
+            bus_write_u16(0x04000208u, saved_ime);
+            std::fprintf(stderr,
+                "runtime_irq: restore IRQ enable at close: IE 0x%04X->0x%04X "
+                "IME 0x%04X->0x%04X\n",
+                ie, saved_ie, ime, saved_ime);
+        }
     }
-    g_cpu.R[0]  = saved_r0;
-    g_cpu.R[1]  = saved_r1;
-    g_cpu.R[2]  = saved_r2;
-    g_cpu.R[3]  = saved_r3;
-    g_cpu.R[12] = saved_r12;
     g_irq_iret_depth = saved_iret;  // restore an enclosing IRQ's expectation
     g_call_return_floor = saved_floor;
     --g_irq_nest_depth;
